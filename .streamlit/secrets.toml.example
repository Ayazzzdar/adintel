# Optional. The app asks for these keys on its connect screen, so you only need this file
# if you want to skip that screen (local: .streamlit/secrets.toml, cloud: app Settings → Secrets).

# Apify — https://console.apify.com/settings/integrations  (required)
APIFY_TOKEN = "apify_api_..."

# Supabase Postgres — Project Settings → Database → Connection string → "Session pooler" URI
# (leave out to use a local SQLite file; data then resets on every Streamlit Cloud redeploy)
DATABASE_URL = "postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Claude — https://platform.claude.com/settings/keys  (needed for AI breakdowns + remix briefs)
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: password-protect the dashboard
APP_PASSWORD = "choose-something"
